APP_NAME=Vietnamese Text Summarization
APP_VERSION=0.1.0
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Model lifecycle
# PRELOAD_MODELS=true

# Input pipeline
# INPUT_MAX_FILE_BYTES=10485760       # 10 MB
# INPUT_ALLOWED_EXTENSIONS=.txt,.docx,.pdf
# INPUT_MIN_TEXT_CHARS=1
# INPUT_MAX_TEXT_CHARS=1000000
# INPUT_URL_TIMEOUT_SEC=20
# INPUT_URL_MAX_BYTES=5242880         # 5 MB
# INPUT_URL_USER_AGENT=VietSumInputBot/0.1 (+local dev)
# INPUT_URL_ALLOW_PRIVATE_HOSTS=false

# Summarization — product defaults (overridable per request)
# SUMMARY_ENGINE=hybrid
# SUMMARY_MAX_SENTENCES=3
# TEXTRANK_MMR_LAMBDA=0.7
# TEXTRANK_POSITION_BIAS=0.12
# HYBRID_PRESELECT_MULTIPLIER=2.0
# HYBRID_PRESELECT_CAP=12
# HYBRID_PRESELECT_FLOOR_SHORT=4
# HYBRID_PRESELECT_FLOOR_MEDIUM=6
# HYBRID_PRESELECT_FLOOR_LONG=8
# HYBRID_VIT5_MIN_CHARS=600
# HYBRID_LONG_DOC_CHARS=12000
# HYBRID_CHUNK_CHARS=4000
# HYBRID_MIN_SUMMARY_CHARS=280

# ViT5 abstractive (requires transformers 4.x — see environment.yml)
# First-time download: set VIT5_ALLOW_DOWNLOAD=1, run server once, then remove the line.
# VIT5_MODEL_NAME=VietAI/vit5-base-vietnews-summarization
# VIT5_ALLOW_DOWNLOAD=1
# VIT5_MAX_INPUT_TOKENS=512
# VIT5_MAX_NEW_TOKENS=256
# VIT5_TOKENS_PER_SENTENCE=64
# VIT5_NUM_BEAMS=4
# VIT5_LEAD_MAX_SENTENCES=2
# VIT5_LEAD_MAX_CHARS=420
# VIT5_LEAD_MAX_WEIRD_CHAR_RATIO=0.06
# VIT5_LEAD_MAX_REPETITION_RATE=0.35

# PhoBERT extractive (requires torch + transformers + pyvi)
# First-time download: set PHOBERT_ALLOW_DOWNLOAD=1, run server once, then remove the line.
# PHOBERT_ALLOW_DOWNLOAD=1
